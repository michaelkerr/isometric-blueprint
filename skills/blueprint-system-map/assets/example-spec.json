  "date": "2026-08-17",
  "skin": "diazo",
  "sheet_heading": "Isometric general arrangement",
  "sheet_subheading": "Control and data paths — all tiers, steady state",

  "nodes": [
    {
      "id": "cdn", "label": "Edge / CDN", "form": "lattice", "tier": "ingress",
      "footprint": [2, 2], "height": 2.4,
      "spec": ["TLS 1.3 termination", "212 PoP, anycast"]
    },
    {
      "id": "gw", "label": "API Gateway", "form": "tower", "tier": "ingress",
      "footprint": [2, 2], "height": 3.4,
      "spec": ["12k req/s sustained", "JWT verify, rate limit"]
    },
    {
      "id": "auth", "label": "Identity Service", "form": "pyramid", "tier": "control",
      "footprint": [2, 2], "height": 2.6,
      "spec": ["OIDC + mTLS", "p99 34 ms"]
    },
    {
      "id": "ordmgr", "label": "Order Core", "form": "core", "tier": "control",
      "footprint": [3, 3], "height": 2.8, "accent": true,
      "spec": ["State machine, 9 states", "Authoritative ledger"]
    },
    {
      "id": "bill", "label": "Billing Engine", "form": "slab", "tier": "control",
      "footprint": [2, 2], "height": 2.2,
      "spec": ["Proration, dunning", "Idempotent by charge key"]
    },
    {
      "id": "ledger", "label": "Ledger Store", "form": "drum", "tier": "state",
      "footprint": [2, 2], "height": 2.4,
      "spec": ["Postgres 16, 3 AZ", "Append-only, 7 yr retention"]
    },
    {
      "id": "queue", "label": "Event Bus", "form": "silo", "tier": "state",
      "footprint": [2, 2], "height": 3.0,
      "spec": ["Kafka, 24 partitions", "At-least-once"]
    },
    {
      "id": "warehouse", "label": "Analytics Warehouse", "form": "vault",
      "tier": "state", "footprint": [3, 2], "height": 2.4,
      "spec": ["Snowflake, hourly load", "Reporting only — never authoritative"]
    },
    {
      "id": "psp", "label": "Payment Processor", "form": "dish", "tier": "external",
      "footprint": [2, 2], "height": 3.0,
      "spec": ["Third party — Stripe", "Outside trust boundary"]
    },
    {
      "id": "obs", "label": "Observability", "form": "plinth", "tier": "external",
      "footprint": [3, 2], "height": 0.8,
      "spec": ["PostHog + OTel collector", "Sampled 1:20"]
    }
  ],

  "edges": [
    { "from": "cdn", "to": "gw", "kind": "data", "payload": "HTTPS /v1/*" },
    { "from": "gw", "to": "auth", "kind": "secure", "payload": "token introspect" },
    { "from": "gw", "to": "ordmgr", "kind": "data", "payload": "order cmd", "accent": true },
    { "from": "ordmgr", "to": "bill", "kind": "control", "payload": "charge intent" },
    { "from": "bill", "to": "psp", "kind": "secure", "payload": "authorise / capture" },
    { "from": "ordmgr", "to": "ledger", "kind": "data", "payload": "state write", "accent": true },
    { "from": "ordmgr", "to": "queue", "kind": "event", "payload": "order.state.changed" },
    { "from": "queue", "to": "warehouse", "kind": "bulk", "payload": "hourly batch" },
    { "from": "bill", "to": "ledger", "kind": "data", "payload": "charge record" },
    { "from": "gw", "to": "obs", "kind": "telemetry", "payload": "traces" },
    { "from": "ordmgr", "to": "obs", "kind": "telemetry", "payload": "metrics" }
  ],

  "explainer": {
    "heading": "Description of operation",
    "paragraphs": [
      "All external traffic terminates at the edge tier and enters the subsystem only through the API gateway (B), which verifies bearer credentials against the identity service (C) before any order command is admitted.",
      "The order core (D) is the single authoritative owner of order state. Every state transition is written to the ledger store (F) in the same transaction that emits the corresponding event to the bus (G); no other component may write F directly."
    ],
    "notes": [
      "The warehouse (H) is a read-only derivative of the event stream. It must never be used as a source of truth for entitlement decisions.",
      "The payment processor (J) sits outside the trust boundary. Capture failures are retried by the billing engine, not by the core.",
      "Telemetry paths are sampled and are not load-bearing. Loss of the observability tier degrades visibility only."
    ]
  }
}
